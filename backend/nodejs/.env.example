# Copy to .env and adjust. Every variable has a development default except where noted.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated origins, or * to allow any (development only)
CORS_ORIGIN=*

# Required in production: at least 16 characters each
JWT_SECRET=
JWT_EXPIRES_IN=12h
ADMIN_API_KEY=

# Storage: json (default), mongodb or postgres
DATABASE_DRIVER=json
JSON_DB_PATH=data/db.json
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB=luxcores
# POSTGRES_URL=postgres://luxcores:luxcores@localhost:5432/luxcores

# Leave empty to keep domain events inside this process
RABBITMQ_URL=
RABBITMQ_QUEUE=luxcores.events
RABBITMQ_PREFETCH=10

# Luxcores repo root, which holds src/sim, data/ and index.html (default: two folders up)
LUXCORES_ROOT=../..
PUBLIC_DIR=public

# An undecided match ends as a draw after this many ticks. Leave it unset to use
# match.stalemateTicks in data/balance.json (10000 ticks, about 8 minutes at 20 Hz).
# Raise it for long test runs between bots or humans.
# MATCH_MAX_TICKS=10000
# Ticks between snapshots: 2 means 10 per second
SNAPSHOT_EVERY_TICKS=2

# Requests per client address and minute: every HTTP route, and the sign-in routes on top
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
# Number of reverse proxies in front of the app (1 behind Caddy or nginx), 0 for none
TRUST_PROXY=0

# Plain WebSocket at /ws: how long a socket may stay unauthenticated, and the biggest frame
WS_AUTH_TIMEOUT_MS=5000
WS_MAX_PAYLOAD_BYTES=16384
