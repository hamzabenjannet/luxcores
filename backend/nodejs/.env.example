# Copy to .env and adjust. Every variable has a development default except where noted.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated origins, or * to allow any (development only)
CORS_ORIGIN=*

# Required in production: at least 16 characters each
JWT_SECRET=
JWT_EXPIRES_IN=12h
ADMIN_API_KEY=

# Storage: auto (default) uses MongoDB when MONGODB_URL is set and the JSON file otherwise. json, mongodb or
# postgres choose one. Whichever database is chosen, an unreachable one means the JSON file serves until the next restart.
DATABASE_DRIVER=auto
# {hostname} in the path becomes the host name: use it when several servers share a volume.
JSON_DB_PATH=data/db.json
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB=luxcores
# PostgreSQL will hold profiles, teams and guilds later. Today the server only checks that it answers.
# POSTGRES_URL=postgres://luxcores:luxcores@localhost:5432/luxcores
# Milliseconds one attempt to reach a database may take, and how long a service gets at start-up before
# the server runs without it until the next restart.
# DATABASE_TIMEOUT_MS=3000
# STARTUP_WAIT_MS=6000

# Redis buffers the match log, holds the match leases and carries room events between servers. Leave it empty to run without.
# REDIS_URL=redis://localhost:6379
# REDIS_TIMEOUT_MS=3000
# Starts every key. Change it to let two deployments share one Redis.
# REDIS_KEY_PREFIX=lux

# Leave empty to keep domain events and match commands inside this process. With it set, each running
# match also gets a command queue, so a client on one server can play a match that another server runs.
RABBITMQ_URL=
RABBITMQ_QUEUE=luxcores.events
RABBITMQ_PREFETCH=10
# RABBITMQ_TIMEOUT_MS=5000

# Several servers: each needs its own NODE_ID. A match lease lasts CLUSTER_LEASE_MS, and a server looks for
# running matches that nobody holds every CLUSTER_ADOPT_EVERY_MS (0 turns the look off).
# NODE_ID=
# CLUSTER_LEASE_MS=10000
# CLUSTER_ADOPT_EVERY_MS=3000
# CLUSTER_RPC_TIMEOUT_MS=1500
# auto: a local match takes commands directly. queue: always through the match queue.
# COMMAND_TRANSPORT=auto

# Luxcores repo root, which holds src/sim, data/ and index.html (default: two folders up)
LUXCORES_ROOT=../..
PUBLIC_DIR=public

# An undecided match ends as a draw after this many ticks. Leave it unset to use
# match.stalemateTicks in data/balance.json (10000 ticks, about 8 minutes at 20 Hz).
# Raise it for long test runs between bots or humans.
# MATCH_MAX_TICKS=10000
# What a graceful stop does to running matches. resume (default) leaves them running, and the
# next start rebuilds them from their logs. end draws them at once.
# MATCH_ON_SHUTDOWN=resume
# Where the write-ahead log of every running match lives (default: an events folder next to the
# JSON database). Put it on a volume in production, or a restart cannot resume matches.
# EVENT_LOG_DIR=data/events
# Milliseconds between log writes. A crash can lose this much of the log, so a resumed match rewinds by about that.
# EVENT_LOG_FLUSH_MS=100
# Keep the log of a finished match everywhere, after its replay is saved (default: delete it from Redis and the files).
# EVENT_LOG_KEEP_FINISHED=false
# Days a finished match keeps its events in MongoDB (0 deletes them when the match ends).
# EVENT_LOG_RETENTION_DAYS=14
# Ticks between two checkpoints of a running match (a multiple of 20, 0 turns them off). A checkpoint lets a
# match resume after a change of the data files or the code, and resume faster. The first one comes at tick 20.
# CHECKPOINT_EVERY_TICKS=400
# Ticks between snapshots: 2 means 10 per second
SNAPSHOT_EVERY_TICKS=2

# Requests per client address and minute: every HTTP route, and the sign-in routes on top
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
# Number of reverse proxies in front of the app (1 behind Caddy or nginx), 0 for none
TRUST_PROXY=0

# Plain WebSocket at /ws: how long a socket may stay unauthenticated, and the biggest frame
WS_AUTH_TIMEOUT_MS=5000
WS_MAX_PAYLOAD_BYTES=16384
