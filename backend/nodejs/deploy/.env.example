# Copy to .env (never commit it) and fill in every value.

# The public host name. Its DNS A record must point at this server before the first start,
# or Caddy cannot get a certificate. Use localhost to test on one machine.
DOMAIN=play.example.com

# Generate each secret with:  openssl rand -base64 36
MONGO_PASSWORD=
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
ADMIN_API_KEY=

# Host ports. Change them only to test on a machine where 80 and 443 are taken.
HTTP_PORT=80
HTTPS_PORT=443
