{
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*.js", "test/**/*.js", "tools/**/*.js"]
}
